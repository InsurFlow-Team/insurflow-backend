# ==============================================================================
# InsurFlow Environment Variables (.env.example)
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# Server runtime environment (development, test, production)
NODE_ENV=development

# HTTP server port
PORT=3000

# MongoDB connection connection string URI
DATABASE_URL=mongodb://localhost:27017/insurflow

# Allowed CORS origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=http://localhost:5173,https://admin.insurflow.app

# JWT secret key for signing tokens (minimum 32 characters recommended)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# JWT token expiration time (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Cloudinary cloud name for media storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Window in milliseconds for login rate limiting (default 15 minutes = 900000)
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Maximum login attempts allowed per window before throttling (default 5)
LOGIN_RATE_LIMIT_MAX=5

# Window in milliseconds for general API rate limiting (default 15 minutes = 900000)
API_RATE_LIMIT_WINDOW_MS=900000

# Maximum API requests allowed per window per IP (default 300)
API_RATE_LIMIT_MAX=300

# Default system operational currency code (e.g. ILS, USD, JOD)
APP_CURRENCY=ILS

# Maximum allowable financial amount for parts, labor, and deductibles (default 1000000)
MAX_FINANCIAL_AMOUNT=1000000

# Public frontend base URL used to construct public claim tracking links
PUBLIC_FRONTEND_URL=https://insurflow.app

# Maximum requests per 15-minute window for the public tracking route (default 60)
PUBLIC_TRACKING_RATE_LIMIT_MAX=60

# Absolute or relative path to Firebase service account JSON for FCM push notifications
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
